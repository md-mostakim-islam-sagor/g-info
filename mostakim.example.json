{
  "app": {
    "name": "GAMES • INFO",
    "guestMode": true,
    "guestDailyLimit": 3,
    "maintenance": false,
    "publicBaseUrl": "https://YOUR-DEPLOYED-URL",
    "trustProxy": true
  },
  "adminLogin": {
    "username": " your username",
    "password": " your password"
  },
  "firebase": {
    "projectId": "YOUR_FIREBASE_PROJECT_ID",
    "authDomain": "YOUR_PROJECT.firebaseapp.com",
    "webApiKeyEnv": "FIREBASE_WEB_API_KEY",
    "serviceAccountEnv": "FIREBASE_SERVICE_ACCOUNT_JSON"
  },
  "admin": {
    "emails": [
      "you@example.com"
    ],
    "uids": []
  },
  "limits": {
    "perKeyPerMin": 30,
    "perUserPerMin": 60,
    "refundCapPerDay": 20
  },
  "cors": {
    "origins": []
  },
  "payment": {
    "methods": [
      "bKash",
      "Nagad"
    ],
    "number": "01XXXXXXXXX",
    "instructions": "Send the exact amount, then submit your transaction ID. Never share your PIN or OTP.",
    "gateways": {
      "bkash": {
        "enabled": false,
        "sandbox": true,
        "usernameEnv": "BKASH_USERNAME",
        "passwordEnv": "BKASH_PASSWORD",
        "appKeyEnv": "BKASH_APP_KEY",
        "appSecretEnv": "BKASH_APP_SECRET"
      },
      "nagad": {
        "enabled": false,
        "sandbox": true,
        "merchantIdEnv": "NAGAD_MERCHANT_ID",
        "privateKeyEnv": "NAGAD_PRIVATE_KEY",
        "pgPublicKeyEnv": "NAGAD_PG_PUBLIC_KEY",
        "baseUrl": ""
      }
    }
  },
  "popup": {
    "enabled": true,
    "title": "Welcome to GAMES • INFO",
    "text": "Check player profiles fast. Join our community for updates.",
    "imageUrl": "/resources/popup.png",
    "cooldownMinutes": 60,
    "buttons": [
      {
        "type": "telegram",
        "label": "Join Telegram",
        "url": "https://t.me/YOUR_CHANNEL"
      },
      {
        "type": "youtube",
        "label": "Subscribe on YouTube",
        "url": "https://youtube.com/@YOUR_CHANNEL"
      }
    ]
  },
  "providers": [
    {
      "name": "RapidAPI ID Game Checker",
      "type": "idgamechecker",
      "enabled": true,
      "order": 0,
      "baseUrl": "https://id-game-checker.p.rapidapi.com",
      "host": "id-game-checker.p.rapidapi.com",
      "apiKeyEnv": "RAPIDAPI_KEY",
      "hostEnv": "RAPIDAPI_HOST",
      "allowSecondaryKey": false,
      "secondaryKeyEnv": "RAPIDAPI_KEY_2",
      "timeoutMs": 8000,
      "maxBytes": 262144,
      "games": {
        "brawlstars": {
          "path": "/brawl-stars/{id}"
        }
      }
    },
    {
      "name": "Full Profile Provider (fill in from its docs)",
      "type": "generic",
      "enabled": false,
      "order": 1,
      "baseUrl": "",
      "apiKeyEnv": "PROFILE_API_KEY",
      "authHeader": "x-api-key",
      "timeoutMs": 8000,
      "games": {
        "freefire": {
          "path": "/REPLACE/WITH/DOCUMENTED/PATH/{id}?region={region}",
          "regions": [],
          "fieldMap": {
            "nickname": "PATH.IN.JSON",
            "level": "PATH",
            "likes": "PATH",
            "region": "PATH",
            "avatarUrl": "PATH",
            "bio": "PATH",
            "account.createdAt": "PATH",
            "account.lastLogin": "PATH",
            "rank.tier": "PATH",
            "pet.name": "PATH",
            "guild.name": "PATH"
          }
        }
      }
    }
  ]
}
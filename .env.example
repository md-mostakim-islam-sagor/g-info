# Put these in Replit Secrets (never commit real values)
NODE_ENV=production
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=id-game-checker.p.rapidapi.com
# RAPIDAPI_KEY_2=optional_second_key   (only used if allowSecondaryKey=true in mostakim.json)
PROFILE_API_KEY=key_for_your_full_profile_provider
FIREBASE_WEB_API_KEY=firebase_web_api_key
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...paste whole JSON on one line...}
ADMIN_EMAILS=you@example.com
PUBLIC_BASE_URL=https://your-deployed-url
# NEVER set ALLOW_DEV_AUTH in production (it is ignored when NODE_ENV=production anyway)

# Admin panel login (optional overrides of mostakim.json adminLogin)
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=long_random_string_so_admin_sessions_survive_restarts
# bKash Merchant (Tokenized Checkout) - credentials given by bKash at onboarding
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
# Nagad Merchant - merchant id + your RSA private key + Nagad's public key (PEM; use \n for newlines or paste the base64 body)
NAGAD_MERCHANT_ID=
NAGAD_PRIVATE_KEY=
NAGAD_PG_PUBLIC_KEY=
